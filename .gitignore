/target
.claude

# TypeDoc / npm tooling for the JS API docs (devDeps only; run `npm run docs:js`)
/node_modules
/package-lock.json

# call recordings written by `ringo-flow run --save-audio`
ringo-audio-*.wav

# generated by `ringo-flow docs` / `ringo-flow definitions`
ringo-flow-api.html
*.d.rhai
# …but the docs ship a checked-in copy (served + linked from the site)
!docs/src/ringo-flow/ringo-flow.d.rhai

# call recordings written by baresip's sndfile module
dump-*.wav

# mdBook build output / assembled docs site
docs/*/book/
docs/book/
/site/

# local docs preview (built by hand for `mdbook`/http.server)
/preview/

# stray local trace/log artifacts
*.log
*.pcap
