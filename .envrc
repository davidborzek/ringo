# Load the flake's devShells.default on cd (nix-direnv). Uses the system's
# nix-direnv when available (NixOS programs.direnv, home-manager); otherwise
# bootstraps the pinned direnvrc itself via direnv's source_url.
if ! has nix_direnv_version || ! nix_direnv_version 3.2.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.2.0/direnvrc" "sha256-hW6NC1JHue3IjZN3uDM6l6I2PMaauqd2D7hXYJ1Zfr4="
fi
use flake
